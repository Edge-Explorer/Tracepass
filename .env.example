# ==============================================================================
# Tracepass Environment Variables & Configuration
# ==============================================================================

# LLM Providers & API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
LLM_PROVIDER=gemini        # Options: gemini, openai, anthropic, ollama
MODEL_NAME=gemini-2.5-flash # e.g. gemini-2.5-flash, gpt-4o, claude-3-7-sonnet

# Agent & Crawl Limits
MAX_DEPTH=5
CRAWL_TIMEOUT_SECONDS=60
OUTPUT_DIR=./outputs

# Logging
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR
